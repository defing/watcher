# RPC URL for the Ethereum JSON-RPC endpoint (e.g., Alchemy, Infura, local node)
RPC_URL="https://mainnet.infura.io/v3/YOUR_KEY"

# Private key with funds and token allowance to move monitored tokens
PRIVATE_KEY="0xYOUR_PRIVATE_KEY"

# ERC20 token contract address to monitor
TOKEN_ADDRESS="0xTOKEN_ADDRESS"

# Address whose balance should be monitored (defaults to wallet address when omitted)
MONITOR_ADDRESS="0xADDRESS_TO_MONITOR"

# Address to receive the tokens after detection
DESTINATION_ADDRESS="0xDESTINATION_ADDRESS"

# Optional interval in milliseconds for polling (defaults to 15000)
POLL_INTERVAL_MS="15000"
